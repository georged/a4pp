@page "/"
@rendermode InteractiveServer
@using System.Text.Json
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>Eris Student</PageTitle>

<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px;">
    <div>
        <h1 style="margin:0">Student Simulator</h1>
        <p class="muted" style="margin:4px 0 0 0">Session key: <strong>@studentKey</strong></p>
    </div>
</div>

@if (showWebhooksDialog)
{
    <div class="dialog-overlay" @onclick="() => showWebhooksDialog = false">
        <div class="dialog-panel" @onclick:stopPropagation>
            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px;">
                <h2 style="margin:0">Registered Webhooks</h2>
                <button @onclick="() => showWebhooksDialog = false">&#x2715;</button>
            </div>
            <div class="field-grid" style="grid-template-columns: 2fr 3fr auto; align-items: end;">
                <div class="field">
                    <label>Name</label>
                    <InputText @bind-Value="createRequest.Name" class="@NameInputClass" />
                </div>
                <div class="field">
                    <label>Endpoint URL</label>
                    <InputText @bind-Value="createRequest.EndpointUrl" class="@UrlInputClass" />
                </div>
                <div class="field">
                    <button @onclick="CreateRegistrationAsync">Add</button>
                </div>
            </div>
            @if (showAddValidation && (NameMissing || UrlMissing))
            {
                <p class="validation-hint">Name and Endpoint URL are required.</p>
            }
            <table class="table" style="margin-top:10px;">
                <thead>
                    <tr>
                        <th class="col-name">Name</th>
                        <th class="col-endpoint">Endpoint</th>
                        <th class="col-actions"></th>
                    </tr>
                </thead>
                <tbody>
                    @if (registrations.Count == 0)
                    {
                        <tr><td colspan="3" class="muted">No webhooks registered yet.</td></tr>
                    }
                    @foreach (var item in registrations)
                    {
                        <tr>
                            <td class="col-name">@item.Name</td>
                            <td class="col-endpoint endpoint-value">@item.EndpointUrl</td>
                            <td class="col-actions"><button @onclick="() => DeleteRegistrationAsync(item.Id)">Deregister</button></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<div class="panel-grid">
    <section class="panel">
        <h2>Send Data</h2>
        <div class="field">
            <label>Destination URL</label>
            <input type="url" value="@destinationUrl" @onchange="OnDestinationUrlChanged"
                   placeholder="https://your-endpoint.example.com/api/ingest" style="width:100%" />
        </div>
        <div class="field-grid">
            <div class="field"><label>Valid</label><input type="number" min="0" @bind="request.ValidCount" /></div>
            <div class="field"><label>Duplicates</label><input type="number" min="0" @bind="request.DuplicateCount" /></div>
            <div class="field"><label>Concurrency</label><input type="number" min="1" max="100" @bind="request.MaxConcurrency" /></div>
            <div class="field"><label>Total</label><input type="number" value="@TotalToSend" readonly /></div>
        </div>
        <button type="button" @onclick="StartSimulationAsync" disabled="@(!CanSend)">Send Data</button>
    </section>

    <section class="panel">
        <h2>Run Stats</h2>
        @if (isRunning)
        {
            <div class="run-indicator" role="status" aria-live="polite">
                <span class="run-spinner" aria-hidden="true"></span>
                <div>
                    <strong>Sending in progress...</strong>
                    <div class="muted">Processed @ProcessedCount of @plannedRequestCount, pending @PendingCount. Elapsed @ElapsedText.</div>
                </div>
            </div>
        }
        <div class="metrics">
            <div><span>Sent</span><strong>@progress.Sent</strong></div>
            <div><span>Succeeded</span><strong>@progress.Succeeded</strong></div>
            <div><span>Failed</span><strong>@progress.Failed</strong></div>
            <div><span>Failure Rate</span><strong>@progress.FailureRate.ToString("0.00")%</strong></div>
        </div>
    </section>
</div>

<section class="panel" style="margin-top:12px;">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px;">
        <h2 style="margin:0">Queue Monitors</h2>
        <button type="button" @onclick="AddQueuePanel">+ Add queue</button>
    </div>

    @if (queuePanels.Count == 0)
    {
        <p class="muted">No queue monitors yet. Click "Add queue" to watch a Service Bus queue fill up and drain.</p>
    }
    else
    {
        <div class="queue-panels-grid">
            @foreach (var panel in queuePanels)
            {
                <div class="queue-card" @key="panel.Id">
                    <div style="display:flex;justify-content:space-between;align-items:center;">
                        <p class="muted" style="margin:0">Queue: <strong>@(panel.Metrics?.QueueName ?? "(not connected)")</strong></p>
                        <button type="button" class="icon-button" title="Remove queue monitor" @onclick="() => RemoveQueuePanel(panel.Id)">&#x2715;</button>
                    </div>
                    <div class="field">
                        <label>Service Bus queue connection string</label>
                        <input type="password"
                               value="@panel.ConnectionString"
                               @onchange="@(e => OnPanelConnectionStringChanged(panel, e))"
                               placeholder="Endpoint=sb://...;SharedAccessKeyName=...;SharedAccessKey=...;EntityPath=registrations" />
                    </div>

                    @if (!string.IsNullOrWhiteSpace(panel.Error))
                    {
                        <p class="validation-hint">@panel.Error</p>
                    }

                    <div class="queue-visual">
                        <div class="queue-ring">
                            <svg class="queue-ring-svg" viewBox="0 0 140 140" aria-hidden="true">
                                <circle class="queue-ring-track" cx="70" cy="70" r="56" fill="none" stroke="#e8eff4" stroke-width="12"></circle>
                                <circle class="queue-ring-progress"
                                        cx="70"
                                        cy="70"
                                        r="56"
                                    fill="none"
                                    stroke="#0f9d8a"
                                    stroke-width="12"
                                    stroke-linecap="round"
                                        style="stroke-dasharray:@QueueRingCircumference;stroke-dashoffset:@(QueueRingCircumference * (1d - (panel.GaugePercent / 100d)))"></circle>
                            </svg>
                            <div class="queue-ring-center">
                                <div class="queue-ring-value">@panel.CurrentDepth</div>
                                <div class="queue-ring-label">messages</div>
                            </div>
                        </div>

                        <div class="queue-meta">
                            <div class="queue-meta-row">
                                <span>Utilization</span>
                                <strong>@panel.GaugePercent.ToString("0.0")%</strong>
                            </div>
                            <div class="queue-meta-row">
                                <span>Gauge max</span>
                                <strong>@panel.GaugeMax</strong>
                            </div>
                            <div class="queue-meta-row">
                                <span>Planned sends</span>
                                <strong>@TotalToSend</strong>
                            </div>
                            <div class="queue-meta-row">
                                <span>Draining Rate</span>
                                <strong>@panel.DrainRateDisplay</strong>
                            </div>
                            <div class="queue-trend @panel.TrendClass">
                                <span>@panel.TrendLabel</span>
                                <strong>@panel.DeltaDisplay</strong>
                            </div>
                        </div>
                    </div>

                    @if (panel.Metrics is null)
                    {
                        <p class="muted">Enter a valid queue connection string to stream live queue depth.</p>
                    }
                </div>
            }
        </div>
    }
</section>

<section class="panel" style="margin-top:12px;">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px;">
        <h2 style="margin:0">Error history <span class="muted" style="font-size:0.8em;font-weight:normal">(last 200)</span></h2>
        <div style="display:flex;gap:8px;">
            <button type="button" @onclick="LoadHistoryAsync" disabled="@(currentRegistrationId == Guid.Empty)">Refresh</button>
            <button type="button" @onclick="ClearHistoryAsync" disabled="@(currentRegistrationId == Guid.Empty)">Clear history</button>
        </div>
    </div>
    @if (!history.Any(x => !x.IsSuccess))
    {
        <p class="muted">No errors yet.</p>
    }
    else
    {
        <table class="table">
            <thead>
                <tr>
                    <th style="width:80px">Sent At</th>
                    <th style="width:60px">Status</th>
                    <th style="width:80px">Latency</th>
                    <th style="width:70px">Duplicate</th>
                    <th>Error</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in history.Where(x => !x.IsSuccess))
                {
                    <tr class="row-fail">
                        <td>@item.SentAtUtc.ToLocalTime().ToString("HH:mm:ss")</td>
                        <td>@(item.StatusCode?.ToString() ?? "N/A")</td>
                        <td>@item.LatencyMs ms</td>
                        <td>@(item.IsDuplicate ? "Yes" : "")</td>
                        <td class="error-cell">@item.Error</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</section>

@code {
    private readonly CreateRegistrationRequest createRequest = new();
    private readonly StartSimulationRequest request = new();
    private List<RegistrationEndpoint> registrations = [];
    private SimulationProgress progress = new();
    private HubConnection? hubConnection;
    private bool isRunning;
    private string studentKey = string.Empty;
    private bool initialized;
    private bool showAddValidation;
    private DateTime? runStartedAtUtc;
    private int plannedRequestCount;
    private CancellationTokenSource? statusTickerCts;

    private bool showWebhooksDialog;
    private string destinationUrl = string.Empty;
    private List<EventDeliveryRecord> history = [];
    private Guid currentRegistrationId = Guid.Empty;
    private List<QueueMonitorPanel> queuePanels = [];
    private CancellationTokenSource? queueMonitorCts;

    private class QueueMonitorPanel
    {
        public Guid Id { get; } = Guid.NewGuid();
        public string ConnectionString { get; set; } = string.Empty;
        public QueueMetricsResponse? Metrics { get; set; }
        public string? Error { get; set; }
        public bool Busy { get; set; }
        public long? LastDepth { get; set; }
        public long Delta { get; set; }
        public long? FrozenGaugeMax { get; set; }
        public DateTime? LastPollAtUtc { get; set; }
        public double DrainedMessages { get; set; }
        public double DrainSeconds { get; set; }

        public long CurrentDepth => Metrics?.ActiveMessageCount ?? 0;
        public long GaugeMax => FrozenGaugeMax ?? RoundGaugeMax(CurrentDepth);
        public double GaugePercent => Math.Min(100d, Math.Max(0d, (double)CurrentDepth / GaugeMax * 100d));
        public string TrendLabel => Delta > 0 ? "Filling" : Delta < 0 ? "Draining" : "Steady";
        public string TrendClass => Delta > 0 ? "trend-up" : Delta < 0 ? "trend-down" : "trend-flat";
        public string DeltaDisplay => Delta > 0 ? $"+{Delta}" : Delta.ToString();
        public double? DrainRatePerSecond => DrainSeconds > 0 ? DrainedMessages / DrainSeconds : null;
        public string DrainRateDisplay => DrainRatePerSecond is double rate ? $"{rate:0.0}/s" : "—";

        public void ResetStats()
        {
            LastDepth = null;
            Delta = 0;
            FrozenGaugeMax = null;
            LastPollAtUtc = null;
            DrainedMessages = 0;
            DrainSeconds = 0;
        }
    }

    private int TotalToSend => Math.Max(0, request.ValidCount) + Math.Max(0, request.DuplicateCount);
    private bool CanSend => !isRunning && !string.IsNullOrWhiteSpace(destinationUrl) && Uri.TryCreate(destinationUrl, UriKind.Absolute, out _) && TotalToSend > 0;
    private bool NameMissing => showAddValidation && string.IsNullOrWhiteSpace(createRequest.Name);
    private bool UrlMissing => showAddValidation && string.IsNullOrWhiteSpace(createRequest.EndpointUrl);
    private string NameInputClass => NameMissing ? "input-invalid" : string.Empty;
    private string UrlInputClass => UrlMissing ? "input-invalid" : string.Empty;
    private int ProcessedCount => Math.Max(0, progress.Sent);
    private int PendingCount => Math.Max(0, plannedRequestCount - ProcessedCount);
    private string ElapsedText => runStartedAtUtc is null
        ? "0s"
        : $"{Math.Max(0, (int)(DateTime.UtcNow - runStartedAtUtc.Value).TotalSeconds)}s";
    private static double QueueRingCircumference => 2d * Math.PI * 56d;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || initialized)
        {
            return;
        }

        initialized = true;
        studentKey = await JS.InvokeAsync<string>("erisStudentKey.getOrCreate");
        await EnsureStudentKeyAsync();
        await LoadRegistrationsAsync();

        destinationUrl = await GetStickyUrlAsync();
        await LoadQueuePanelsAsync();
        if (!string.IsNullOrWhiteSpace(destinationUrl))
        {
            var reg = registrations.FirstOrDefault(r => string.Equals(r.EndpointUrl, destinationUrl.Trim(), StringComparison.OrdinalIgnoreCase));
            if (reg is not null)
            {
                currentRegistrationId = reg.Id;
                await LoadHistoryAsync();
            }
        }

        StartQueueMonitor();
        StateHasChanged();
    }

    private async Task OnDestinationUrlChanged(ChangeEventArgs e)
    {
        destinationUrl = e.Value?.ToString() ?? string.Empty;
        await SetStickyUrlAsync(destinationUrl);
    }

    private async Task OnPanelConnectionStringChanged(QueueMonitorPanel panel, ChangeEventArgs e)
    {
        panel.ConnectionString = e.Value?.ToString() ?? string.Empty;
        panel.ResetStats();
        await SaveQueuePanelsAsync();
        await RefreshQueuePanelAsync(panel);
    }

    private async Task AddQueuePanel()
    {
        queuePanels.Add(new QueueMonitorPanel());
        await SaveQueuePanelsAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task RemoveQueuePanel(Guid id)
    {
        queuePanels.RemoveAll(p => p.Id == id);
        await SaveQueuePanelsAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task<string> GetStickyUrlAsync()
    {
        try
        {
            return await JS.InvokeAsync<string?>("erisStudentKey.getStickyUrl") ?? string.Empty;
        }
        catch (JSException)
        {
            // Fallback for stale browser script cache where helper methods may be missing.
            return await JS.InvokeAsync<string?>("localStorage.getItem", "eris-destination-url") ?? string.Empty;
        }
    }

    private async Task SetStickyUrlAsync(string value)
    {
        try
        {
            await JS.InvokeVoidAsync("erisStudentKey.setStickyUrl", value);
        }
        catch (JSException)
        {
            // Keep sticky URL behavior even when custom JS helpers aren't available.
            await JS.InvokeVoidAsync("localStorage.setItem", "eris-destination-url", value);
        }
    }

    private async Task LoadQueuePanelsAsync()
    {
        var connections = await GetQueueConnectionStringsAsync();
        queuePanels = connections.Count > 0
            ? connections.Select(cs => new QueueMonitorPanel { ConnectionString = cs }).ToList()
            : [new QueueMonitorPanel()];
    }

    private async Task<List<string>> GetQueueConnectionStringsAsync()
    {
        var json = await JS.InvokeAsync<string?>("localStorage.getItem", "eris-queue-connections");
        if (!string.IsNullOrWhiteSpace(json))
        {
            try
            {
                return JsonSerializer.Deserialize<List<string>>(json) ?? [];
            }
            catch (JsonException)
            {
                return [];
            }
        }

        // Back-compat: migrate the previous single-queue connection string, if any.
        var legacy = await JS.InvokeAsync<string?>("localStorage.getItem", "eris-queue-connection");
        return string.IsNullOrWhiteSpace(legacy) ? [] : [legacy];
    }

    private async Task SaveQueuePanelsAsync()
    {
        var connections = queuePanels.Select(p => p.ConnectionString).ToList();
        await JS.InvokeVoidAsync("localStorage.setItem", "eris-queue-connections", JsonSerializer.Serialize(connections));
    }

    private async Task EnsureStudentKeyAsync()
    {
        var me = await GetJsonAsync<Dictionary<string, string>>("/api/me");
        if (me is not null && me.TryGetValue("studentKey", out var value) && !string.IsNullOrWhiteSpace(value))
        {
            studentKey = value;
            await JS.InvokeVoidAsync("erisStudentKey.set", value);
        }
    }

    private async Task<T?> GetJsonAsync<T>(string url)
    {
        using var requestMessage = new HttpRequestMessage(HttpMethod.Get, url);
        requestMessage.Headers.Add("X-Eris-Student-Key", studentKey);
        using var response = await Http.SendAsync(requestMessage);
        response.EnsureSuccessStatusCode();
        return await response.Content.ReadFromJsonAsync<T>();
    }

    private async Task<HttpResponseMessage> PostJsonAsync<T>(string url, T payload)
    {
        using var requestMessage = new HttpRequestMessage(HttpMethod.Post, url)
        {
            Content = JsonContent.Create(payload)
        };
        requestMessage.Headers.Add("X-Eris-Student-Key", studentKey);
        var response = await Http.SendAsync(requestMessage);
        response.EnsureSuccessStatusCode();
        return response;
    }

    private async Task LoadRegistrationsAsync()
    {
        registrations = await GetJsonAsync<List<RegistrationEndpoint>>("/api/registrations") ?? [];
    }

    private async Task CreateRegistrationAsync()
    {
        showAddValidation = true;

        if (string.IsNullOrWhiteSpace(createRequest.Name) || string.IsNullOrWhiteSpace(createRequest.EndpointUrl))
        {
            return;
        }

        await PostJsonAsync("/api/registrations", createRequest);
        createRequest.Name = string.Empty;
        createRequest.EndpointUrl = string.Empty;
        showAddValidation = false;
        await LoadRegistrationsAsync();
    }

    private async Task StartSimulationAsync()
    {
        showAddValidation = false;

        if (string.IsNullOrWhiteSpace(destinationUrl) || string.IsNullOrWhiteSpace(studentKey))
        {
            return;
        }

        var registrationId = await ResolveRegistrationIdAsync(destinationUrl.Trim());
        if (registrationId == Guid.Empty)
        {
            return;
        }

        currentRegistrationId = registrationId;
        request.Scenario = "mixed";
        request.Count = TotalToSend;
        plannedRequestCount = TotalToSend;
        await CaptureQueueGaugeMaxAsync();

        var response = await PostJsonAsync($"/api/registrations/{registrationId}/simulate", request);
        var payload = await response.Content.ReadFromJsonAsync<Dictionary<string, string>>();
        if (payload is null || !payload.TryGetValue("runId", out var runIdText) || !Guid.TryParse(runIdText, out var runId))
        {
            return;
        }

        await ConnectSimulationAsync(runId);
    }

    private async Task ConnectSimulationAsync(Guid runId)
    {
        isRunning = true;
        progress = new SimulationProgress();
        runStartedAtUtc = DateTime.UtcNow;
        StartStatusTicker();
        await InvokeAsync(StateHasChanged);

        if (hubConnection is not null)
        {
            await hubConnection.DisposeAsync();
        }

        hubConnection = new HubConnectionBuilder()
            .WithUrl(Navigation.ToAbsoluteUri("/hubs/simulation"))
            .WithAutomaticReconnect()
            .Build();

        hubConnection.On<SimulationProgress>("progress", value =>
        {
            progress = value;
            isRunning = value.IsRunning;
            if (!isRunning)
            {
                StopStatusTicker();
            }
            InvokeAsync(StateHasChanged);
        });

        hubConnection.On<Dictionary<string, object>>("completed", _ =>
        {
            isRunning = false;
            StopStatusTicker();
            var historyTask = LoadHistoryAsync();
            InvokeAsync(StateHasChanged);
        });

        await hubConnection.StartAsync();
        await hubConnection.InvokeAsync("JoinSimulation", runId.ToString());
    }

    private async Task LoadHistoryAsync()
    {
        if (currentRegistrationId == Guid.Empty)
        {
            return;
        }

        history = await GetJsonAsync<List<EventDeliveryRecord>>($"/api/registrations/{currentRegistrationId}/history") ?? [];
        await InvokeAsync(StateHasChanged);
    }

    private async Task RefreshAllQueueMetricsAsync()
    {
        await Task.WhenAll(queuePanels.Select(RefreshQueuePanelAsync));
    }

    private async Task RefreshQueuePanelAsync(QueueMonitorPanel panel)
    {
        if (panel.Busy)
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(panel.ConnectionString))
        {
            panel.Metrics = null;
            panel.Error = null;
            panel.ResetStats();
            await InvokeAsync(StateHasChanged);
            return;
        }

        panel.Busy = true;
        try
        {
            var latest = await TryFetchQueueMetricsAsync(panel);
            if (latest is not null)
            {
                ApplyQueueMetrics(panel, latest);
            }
        }
        catch (Exception ex)
        {
            panel.Metrics = null;
            panel.Error = ex.Message;
        }
        finally
        {
            panel.Busy = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task CaptureQueueGaugeMaxAsync()
    {
        foreach (var panel in queuePanels)
        {
            if (!string.IsNullOrWhiteSpace(panel.ConnectionString))
            {
                var latest = await TryFetchQueueMetricsAsync(panel);
                if (latest is not null)
                {
                    ApplyQueueMetrics(panel, latest);
                }
            }

            panel.FrozenGaugeMax = RoundGaugeMax(panel.CurrentDepth + TotalToSend);
        }
    }

    private async Task<QueueMetricsResponse?> TryFetchQueueMetricsAsync(QueueMonitorPanel panel)
    {
        using var requestMessage = new HttpRequestMessage(HttpMethod.Post, "/api/queue/metrics")
        {
            Content = JsonContent.Create(new QueueMetricsRequest
            {
                ConnectionString = panel.ConnectionString,
                PlannedAdditionalMessages = TotalToSend
            })
        };
        requestMessage.Headers.Add("X-Eris-Student-Key", studentKey);

        using var response = await Http.SendAsync(requestMessage);
        if (!response.IsSuccessStatusCode)
        {
            panel.Metrics = null;
            panel.Error = await response.Content.ReadAsStringAsync();
            return null;
        }

        var latest = await response.Content.ReadFromJsonAsync<QueueMetricsResponse>();
        panel.Error = null;
        return latest;
    }

    private static void ApplyQueueMetrics(QueueMonitorPanel panel, QueueMetricsResponse latest)
    {
        var now = DateTime.UtcNow;

        if (panel.LastDepth.HasValue && panel.LastPollAtUtc.HasValue)
        {
            panel.Delta = latest.ActiveMessageCount - panel.LastDepth.Value;

            var elapsedSeconds = (now - panel.LastPollAtUtc.Value).TotalSeconds;
            if (panel.Delta < 0 && elapsedSeconds > 0)
            {
                panel.DrainedMessages += -panel.Delta;
                panel.DrainSeconds += elapsedSeconds;
            }
        }
        else
        {
            panel.Delta = 0;
        }

        panel.LastDepth = latest.ActiveMessageCount;
        panel.LastPollAtUtc = now;
        panel.Metrics = latest;
    }

    private static long RoundGaugeMax(long value)
    {
        var normalized = Math.Max(100L, value);
        return ((normalized + 99L) / 100L) * 100L;
    }

    private async Task ClearHistoryAsync()
    {
        if (currentRegistrationId == Guid.Empty)
        {
            return;
        }

        using var requestMessage = new HttpRequestMessage(HttpMethod.Delete, $"/api/registrations/{currentRegistrationId}/history");
        requestMessage.Headers.Add("X-Eris-Student-Key", studentKey);
        using var response = await Http.SendAsync(requestMessage);
        if (!response.IsSuccessStatusCode)
        {
            return;
        }

        history = [];
        await InvokeAsync(StateHasChanged);
    }

    private async Task<Guid> ResolveRegistrationIdAsync(string endpointUrl)
    {
        using var response = await PostJsonAsync("/api/registrations/resolve", new ResolveRegistrationRequest { EndpointUrl = endpointUrl });
        var payload = await response.Content.ReadFromJsonAsync<Dictionary<string, string>>();
        if (payload is null || !payload.TryGetValue("id", out var idText) || !Guid.TryParse(idText, out var id))
        {
            return Guid.Empty;
        }

        return id;
    }

    private async Task DeleteRegistrationAsync(Guid id)
    {
        using var requestMessage = new HttpRequestMessage(HttpMethod.Delete, $"/api/registrations/{id}");
        requestMessage.Headers.Add("X-Eris-Student-Key", studentKey);
        using var response = await Http.SendAsync(requestMessage);

        if (!response.IsSuccessStatusCode)
        {
            return;
        }

        await LoadRegistrationsAsync();
    }

    public async ValueTask DisposeAsync()
    {
        StopStatusTicker();
        StopQueueMonitor();

        if (hubConnection is not null)
        {
            await hubConnection.DisposeAsync();
        }
    }

    private void StartStatusTicker()
    {
        StopStatusTicker();
        statusTickerCts = new CancellationTokenSource();
        _ = RunStatusTickerAsync(statusTickerCts.Token);
    }

    private void StopStatusTicker()
    {
        if (statusTickerCts is null)
        {
            return;
        }

        statusTickerCts.Cancel();
        statusTickerCts.Dispose();
        statusTickerCts = null;
    }

    private async Task RunStatusTickerAsync(CancellationToken ct)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(1));
        try
        {
            while (await timer.WaitForNextTickAsync(ct))
            {
                if (!isRunning)
                {
                    break;
                }

                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    private void StartQueueMonitor()
    {
        StopQueueMonitor();
        queueMonitorCts = new CancellationTokenSource();
        _ = RunQueueMonitorAsync(queueMonitorCts.Token);
    }

    private void StopQueueMonitor()
    {
        if (queueMonitorCts is null)
        {
            return;
        }

        queueMonitorCts.Cancel();
        queueMonitorCts.Dispose();
        queueMonitorCts = null;
    }

    private async Task RunQueueMonitorAsync(CancellationToken ct)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(2));
        try
        {
            await RefreshAllQueueMetricsAsync();
            while (await timer.WaitForNextTickAsync(ct))
            {
                await RefreshAllQueueMetricsAsync();
            }
        }
        catch (OperationCanceledException)
        {
        }
    }
}
