{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.42.1.51946",
      "templateHash": "7799307497168417231"
    }
  },
  "parameters": {
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Azure region for all resources."
      }
    },
    "appName": {
      "type": "string",
      "defaultValue": "eris",
      "metadata": {
        "description": "Short prefix used for generated resource names."
      }
    },
    "containerAppName": {
      "type": "string",
      "defaultValue": "eris-api",
      "metadata": {
        "description": "Container App resource name."
      }
    },
    "adminKey": {
      "type": "securestring",
      "metadata": {
        "description": "Admin key injected into the application configuration."
      }
    },
    "containerImage": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Full container image reference. Leave empty to deploy infrastructure without the app revision."
      }
    },
    "databasePath": {
      "type": "string",
      "defaultValue": "/tmp/eris/eris.db",
      "metadata": {
        "description": "Ephemeral SQLite path inside the container filesystem."
      }
    },
    "minReplicas": {
      "type": "int",
      "defaultValue": 1,
      "minValue": 1,
      "metadata": {
        "description": "Minimum number of app replicas."
      }
    },
    "maxReplicas": {
      "type": "int",
      "defaultValue": 1,
      "minValue": 1,
      "metadata": {
        "description": "Maximum number of app replicas."
      }
    },
    "cpu": {
      "type": "int",
      "defaultValue": 1,
      "minValue": 1,
      "metadata": {
        "description": "CPU cores allocated to the container."
      }
    },
    "memory": {
      "type": "string",
      "defaultValue": "2Gi",
      "metadata": {
        "description": "Memory allocated to the container."
      }
    },
    "tags": {
      "type": "object",
      "defaultValue": {
        "application": "eris",
        "environment": "prod",
        "managedBy": "copilot"
      },
      "metadata": {
        "description": "Tags applied to Azure resources."
      }
    }
  },
  "variables": {
    "sanitizedAppName": "[toLower(replace(parameters('appName'), '-', ''))]",
    "suffix": "[toLower(take(uniqueString(subscription().subscriptionId, resourceGroup().id, parameters('appName')), 6))]",
    "acrName": "[take(format('{0}{1}acr', variables('sanitizedAppName'), variables('suffix')), 50)]",
    "workspaceName": "[format('{0}-logs-{1}', parameters('appName'), variables('suffix'))]",
    "managedEnvironmentName": "[format('{0}-env', parameters('appName'))]",
    "deployContainerApp": "[not(empty(parameters('containerImage')))]",
    "acrPullRoleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', '7f951dda-4ed3-4680-a7ca-43fe172d538d')]"
  },
  "resources": [
    {
      "type": "Microsoft.ContainerRegistry/registries",
      "apiVersion": "2023-07-01",
      "name": "[variables('acrName')]",
      "location": "[parameters('location')]",
      "sku": {
        "name": "Basic"
      },
      "tags": "[parameters('tags')]",
      "properties": {
        "adminUserEnabled": false,
        "publicNetworkAccess": "Enabled"
      }
    },
    {
      "type": "Microsoft.OperationalInsights/workspaces",
      "apiVersion": "2022-10-01",
      "name": "[variables('workspaceName')]",
      "location": "[parameters('location')]",
      "tags": "[parameters('tags')]",
      "properties": {
        "features": {
          "disableLocalAuth": false,
          "enableLogAccessUsingOnlyResourcePermissions": true
        },
        "publicNetworkAccessForIngestion": "Enabled",
        "publicNetworkAccessForQuery": "Enabled",
        "retentionInDays": 30,
        "sku": {
          "name": "PerGB2018"
        }
      }
    },
    {
      "type": "Microsoft.App/managedEnvironments",
      "apiVersion": "2024-10-02-preview",
      "name": "[variables('managedEnvironmentName')]",
      "location": "[parameters('location')]",
      "tags": "[parameters('tags')]",
      "properties": {
        "appLogsConfiguration": {
          "destination": "log-analytics",
          "logAnalyticsConfiguration": {
            "customerId": "[reference(resourceId('Microsoft.OperationalInsights/workspaces', variables('workspaceName')), '2022-10-01').customerId]",
            "sharedKey": "[listKeys(resourceId('Microsoft.OperationalInsights/workspaces', variables('workspaceName')), '2022-10-01').primarySharedKey]"
          }
        },
        "publicNetworkAccess": "Enabled",
        "zoneRedundant": false
      },
      "dependsOn": [
        "[resourceId('Microsoft.OperationalInsights/workspaces', variables('workspaceName'))]"
      ]
    },
    {
      "condition": "[variables('deployContainerApp')]",
      "type": "Microsoft.App/containerApps",
      "apiVersion": "2025-01-01",
      "name": "[parameters('containerAppName')]",
      "location": "[parameters('location')]",
      "identity": {
        "type": "SystemAssigned"
      },
      "tags": "[parameters('tags')]",
      "properties": {
        "environmentId": "[resourceId('Microsoft.App/managedEnvironments', variables('managedEnvironmentName'))]",
        "configuration": {
          "activeRevisionsMode": "Single",
          "ingress": {
            "allowInsecure": false,
            "external": true,
            "targetPort": 8080,
            "transport": "auto"
          },
          "registries": [
            {
              "identity": "system",
              "server": "[reference(resourceId('Microsoft.ContainerRegistry/registries', variables('acrName')), '2023-07-01').loginServer]"
            }
          ],
          "secrets": [
            {
              "name": "admin-key",
              "value": "[parameters('adminKey')]"
            }
          ]
        },
        "template": {
          "containers": [
            {
              "image": "[parameters('containerImage')]",
              "name": "eris-api",
              "env": [
                {
                  "name": "ASPNETCORE_ENVIRONMENT",
                  "value": "Production"
                },
                {
                  "name": "Admin__Key",
                  "secretRef": "admin-key"
                },
                {
                  "name": "ERIS_DB_PATH",
                  "value": "[parameters('databasePath')]"
                }
              ],
              "probes": [
                {
                  "httpGet": {
                    "path": "/health",
                    "port": 8080
                  },
                  "initialDelaySeconds": 10,
                  "periodSeconds": 20,
                  "timeoutSeconds": 5,
                  "type": "Liveness"
                },
                {
                  "httpGet": {
                    "path": "/health",
                    "port": 8080
                  },
                  "initialDelaySeconds": 5,
                  "periodSeconds": 10,
                  "timeoutSeconds": 5,
                  "type": "Readiness"
                }
              ],
              "resources": {
                "cpu": "[parameters('cpu')]",
                "memory": "[parameters('memory')]"
              }
            }
          ],
          "scale": {
            "maxReplicas": "[parameters('maxReplicas')]",
            "minReplicas": "[parameters('minReplicas')]"
          }
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.ContainerRegistry/registries', variables('acrName'))]",
        "[resourceId('Microsoft.App/managedEnvironments', variables('managedEnvironmentName'))]"
      ]
    },
    {
      "condition": "[variables('deployContainerApp')]",
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "scope": "[resourceId('Microsoft.ContainerRegistry/registries', variables('acrName'))]",
      "name": "[guid(resourceId('Microsoft.ContainerRegistry/registries', variables('acrName')), resourceId('Microsoft.App/containerApps', parameters('containerAppName')), variables('acrPullRoleDefinitionId'))]",
      "properties": {
        "principalId": "[reference(resourceId('Microsoft.App/containerApps', parameters('containerAppName')), '2025-01-01', 'full').identity.principalId]",
        "principalType": "ServicePrincipal",
        "roleDefinitionId": "[variables('acrPullRoleDefinitionId')]"
      },
      "dependsOn": [
        "[resourceId('Microsoft.App/containerApps', parameters('containerAppName'))]",
        "[resourceId('Microsoft.ContainerRegistry/registries', variables('acrName'))]"
      ]
    }
  ],
  "outputs": {
    "acrName": {
      "type": "string",
      "value": "[variables('acrName')]"
    },
    "acrLoginServer": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.ContainerRegistry/registries', variables('acrName')), '2023-07-01').loginServer]"
    },
    "managedEnvironmentId": {
      "type": "string",
      "value": "[resourceId('Microsoft.App/managedEnvironments', variables('managedEnvironmentName'))]"
    },
    "containerAppId": {
      "type": "string",
      "value": "[if(variables('deployContainerApp'), resourceId('Microsoft.App/containerApps', parameters('containerAppName')), '')]"
    },
    "containerAppUrl": {
      "type": "string",
      "value": "[if(variables('deployContainerApp'), format('https://{0}', reference(resourceId('Microsoft.App/containerApps', parameters('containerAppName')), '2025-01-01').configuration.ingress.fqdn), '')]"
    }
  }
}